<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJI Proxy Linker"
        Width="600" Height="780" MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF111214"
        Foreground="#FFECEEF1"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Style>
    <Style TargetType="Window">
      <Setter Property="BorderBrush" Value="#FF26292E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <!-- WindowChrome maximized windows overflow the screen edge; compensate -->
        <Trigger Property="WindowState" Value="Maximized">
          <Setter Property="BorderThickness" Value="7"/>
          <Setter Property="BorderBrush" Value="#FF111214"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Style>

  <Window.Resources>
    <!-- ============ Palette ============ -->
    <Color x:Key="AccentColor">#FFF2A541</Color>
    <SolidColorBrush x:Key="Bg" Color="#FF111214"/>
    <SolidColorBrush x:Key="Surface" Color="#FF17191C"/>
    <SolidColorBrush x:Key="Surface2" Color="#FF1D2024"/>
    <SolidColorBrush x:Key="Surface3" Color="#FF25282D"/>
    <SolidColorBrush x:Key="Line" Color="#FF26292E"/>
    <SolidColorBrush x:Key="LineStrong" Color="#FF363A40"/>
    <SolidColorBrush x:Key="Text" Color="#FFECEEF1"/>
    <SolidColorBrush x:Key="Text2" Color="#FFB4BAC1"/>
    <SolidColorBrush x:Key="Muted" Color="#FF8A9199"/>
    <SolidColorBrush x:Key="Faint" Color="#FF7A818A"/>
    <SolidColorBrush x:Key="Accent" Color="#FFF2A541"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FFF7B862"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#FFDB9033"/>
    <SolidColorBrush x:Key="AccentFg" Color="#FF1C1306"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1FF2A541"/>
    <SolidColorBrush x:Key="OkBrush" Color="#FF4CC38A"/>
    <SolidColorBrush x:Key="SkipBrush" Color="#FF7C838C"/>
    <SolidColorBrush x:Key="ErrBrush" Color="#FFF2706D"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#FF6EA8F2"/>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ============ Focus ring ============ -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="#B3F2A541" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Title bar buttons ============ -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Foreground" Value="#FFB4BAC1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                <Setter Property="Foreground" Value="#FFECEEF1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFC42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFA92A1E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Primary button (Tag = glyph) ============ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="20,0,22,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                           FontSize="15" FontWeight="Normal" VerticalAlignment="Center" Margin="0,1,10,0"/>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#FF222529"/>
                <Setter Property="Foreground" Value="#FF60666E"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Ghost button (optional Tag = glyph) ============ -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                           FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0"/>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#FF5E646C"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF25282D"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Footer link button ============ -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Sponsor pill ============ -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,5,12,5"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#66F2A541"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Segmented radio (Tag = glyph) ============ -->
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                           FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF33373D"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Progress ============ -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#FF1E2125"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Dark scrollbar (implicit) ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="#FF3A3E45" CornerRadius="3" Margin="2,0"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="Background" Value="#FF50555D"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="T" Property="Background" Value="#FF5E646C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Margin="0,4">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent" Margin="4,0">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ============ Stat chip ============ -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,3,9,4"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChipNumber" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="6,0,4,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChipLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <!-- ============ Title bar tabs (Tag = glyph) ============ -->
    <Style x:Key="TabRadio" TargetType="RadioButton">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="11,0,13,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,1,7,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Dark checkbox ============ -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                      BorderBrush="#FF4A4F57" Background="#FF15171A" VerticalAlignment="Top" Margin="0,1,0,0">
                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                           FontWeight="Bold" Foreground="{StaticResource AccentFg}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#FF6A7079"/>
                <Setter TargetName="Box" Property="Background" Value="#FF1D2024"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentHover}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ Path text box (Tag = glyph) ============ -->
    <Style x:Key="PathBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionOpacity" Value="0.35"/>
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                           FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="12,1,0,0"/>
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center"
                              Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4A4F57"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#CCF2A541"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="Margin" Value="2,0,0,7"/>
    </Style>
    <Style x:Key="Placeholder" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#FF5A6068"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="35,0,10,0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- ============ Log card header ============ -->
    <Style x:Key="LogHeader" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="16,0,10,0"/>
      <Setter Property="Height" Value="42"/>
    </Style>
    <Style x:Key="LogCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- ============ Log row ============ -->
    <DataTemplate x:Key="LogRowTemplate">
      <Border x:Name="Row" Padding="12,6,12,6" Background="Transparent" CornerRadius="6" Margin="4,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                     Foreground="{StaticResource InfoBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="12.5" Foreground="{StaticResource Text}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Ok">
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource OkBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Skip">
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource SkipBrush}"/>
          <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Text2}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Error">
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ErrBrush}"/>
          <Setter TargetName="DetailText" Property="Foreground" Value="#FFE79A97"/>
          <Setter TargetName="Row" Property="Background" Value="#14F2706D"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Info">
          <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource InfoBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Detail}" Value="">
          <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
          <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="#0AFFFFFF"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ Log list (shared by LogList and SyncLog) ============ -->
    <Style x:Key="LogListStyle" TargetType="ItemsControl">
      <Setter Property="ItemTemplate" Value="{StaticResource LogRowTemplate}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer Padding="0,6,4,6" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
              <ItemsPresenter/>
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================= Title bar ================= -->
    <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Bg}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <!-- app icon (same drawing as Icon.xaml) -->
        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
          <Canvas Width="256" Height="256">
            <Canvas.Resources>
              <LinearGradientBrush x:Key="TileFill" StartPoint="0,8" EndPoint="0,248" MappingMode="Absolute">
                <GradientStop Color="#FFF7B85E" Offset="0"/>
                <GradientStop Color="#FFEC9431" Offset="1"/>
              </LinearGradientBrush>
            </Canvas.Resources>
            <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56"
                       Fill="{StaticResource TileFill}"/>
            <Rectangle Canvas.Left="38" Canvas.Top="54" Width="144" Height="104" RadiusX="22" RadiusY="22"
                       Stroke="#FF1C1306" StrokeThickness="20" Fill="Transparent"/>
            <Rectangle Canvas.Left="98" Canvas.Top="110" Width="124" Height="92" RadiusX="20" RadiusY="20"
                       Fill="#FF1C1306" Stroke="{StaticResource TileFill}" StrokeThickness="16"/>
            <Path Fill="#FFF5AD4F"
                  Data="M 146,140 L 146,172 C 146,177 151,180 155,177 L 178,161 C 182,158 182,154 178,151 L 155,135 C 151,132 146,135 146,140 Z"/>
          </Canvas>
        </Viewbox>
        <TextBlock Text="DJI Proxy Linker" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                   VerticalAlignment="Center" Margin="10,0,0,1"/>
      </StackPanel>

      <!-- tabs -->
      <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,12,0"
              Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
              CornerRadius="8" Padding="2">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabLink" GroupName="Tab" IsChecked="True" Style="{StaticResource TabRadio}"
                       Tag="&#xE71B;" Content="Прокси"/>
          <RadioButton x:Name="TabSync" GroupName="Tab" Style="{StaticResource TabRadio}"
                       Tag="&#xE8CE;" Content="С сервера" Margin="2,0,0,0"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <!-- ================= Page: link proxies ================= -->
    <Grid x:Name="PageLink" Grid.Row="1" Margin="20,6,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" MinHeight="112" MaxHeight="164"/> <!-- drop zone (shrinks on small windows) -->
        <RowDefinition Height="Auto"/>  <!-- mode + options -->
        <RowDefinition Height="Auto"/>  <!-- actions -->
        <RowDefinition Height="Auto"/>  <!-- progress -->
        <RowDefinition Height="5*" MinHeight="112"/> <!-- log -->
      </Grid.RowDefinitions>

      <!-- ===== Drop zone ===== -->
      <Border x:Name="DropZone" Grid.Row="0" AllowDrop="True" Cursor="Hand" CornerRadius="12"
              BorderThickness="0">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF1A1C20"/>
              </Trigger>
              <Trigger Property="Tag" Value="Filled">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
              </Trigger>
              <Trigger Property="Tag" Value="Over">
                <Setter Property="Background" Value="#FF201C16"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <!-- dashed / solid outline -->
          <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1.5" SnapsToDevicePixels="False">
            <Rectangle.Style>
              <Style TargetType="Rectangle">
                <Setter Property="Stroke" Value="#FF3A3E45"/>
                <Setter Property="StrokeDashArray" Value="4 3"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=DropZone}" Value="True">
                    <Setter Property="Stroke" Value="#FF50555D"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Tag, ElementName=DropZone}" Value="Filled">
                    <Setter Property="Stroke" Value="#FF34383E"/>
                    <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Tag, ElementName=DropZone}" Value="Over">
                    <Setter Property="Stroke" Value="{StaticResource Accent}"/>
                    <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Rectangle.Style>
          </Rectangle>

          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="24,0">
            <Border Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource Surface3}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, ElementName=DropZone}" Value="Filled">
                      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, ElementName=DropZone}" Value="Over">
                      <Setter Property="Background" Value="{StaticResource Accent}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="&#xE8F4;"/>
                    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Tag, ElementName=DropZone}" Value="Filled">
                        <Setter Property="Text" Value="&#xE8B7;"/>
                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Tag, ElementName=DropZone}" Value="Over">
                        <Setter Property="Text" Value="&#xE896;"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentFg}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
            <TextBlock x:Name="DropTitle" Text="Перетащите папки с видео сюда" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource Text}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
            <TextBlock x:Name="DropHint" Text="или нажмите, чтобы выбрать папку" FontSize="12.5"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Mode ===== -->
      <StackPanel Grid.Row="1" Margin="0,18,0,0">
        <TextBlock Text="РЕЖИМ" Style="{StaticResource SectionLabel}" Margin="2,0,0,8"/>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Padding="3">
          <UniformGrid Columns="3">
            <RadioButton x:Name="ModeMove" GroupName="Mode" IsChecked="True" Style="{StaticResource SegmentRadio}"
                         Tag="&#xE8DE;" Content="Перенести"/>
            <RadioButton x:Name="ModeCopy" GroupName="Mode" Style="{StaticResource SegmentRadio}"
                         Tag="&#xE8C8;" Content="Копировать" Margin="3,0"/>
            <RadioButton x:Name="ModeUndo" GroupName="Mode" Style="{StaticResource SegmentRadio}"
                         Tag="&#xE7A7;" Content="Откатить"/>
          </UniformGrid>
        </Border>
        <TextBlock x:Name="ModeHint" Text="LRF переносятся в подпапку Proxy и получают расширение .MP4"
                   FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                   Margin="2,8,0,0"/>
        <CheckBox x:Name="SonyFlatten" Style="{StaticResource DarkCheck}" Margin="2,14,0,0"
                  HorizontalAlignment="Left">
          <StackPanel>
            <TextBlock Text="Sony: поднять клипы из CLIP наверх" FontSize="13" Foreground="{StaticResource Text}"/>
            <TextBlock Text="Клипы из CLIP → в папку камеры, SUB → Proxy. Для сервера, до импорта в DaVinci"
                       FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </CheckBox>
      </StackPanel>

      <!-- ===== Actions ===== -->
      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="RunButton" Content="Создать прокси" MinWidth="176">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
              <Setter Property="Tag" Value="&#xE71B;"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=ModeUndo}" Value="True">
                  <Setter Property="Tag" Value="&#xE7A7;"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button x:Name="ClearButton" Grid.Column="1" Content="Очистить" Style="{StaticResource GhostButton}"
                Margin="8,0,0,0"/>
        <TextBlock x:Name="StatusText" Grid.Column="2" Text="" FontSize="12" Foreground="{StaticResource Muted}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"
                   TextTrimming="CharacterEllipsis" Margin="12,0,2,0"/>
      </Grid>

      <!-- ===== Progress ===== -->
      <ProgressBar x:Name="Progress" Grid.Row="3" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100"
                   Value="0" Margin="0,14,0,0"/>

      <!-- ===== Log ===== -->
      <Border Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource LogCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- header -->
          <Border Style="{StaticResource LogHeader}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Журнал" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountDone" Text="0" Style="{StaticResource ChipNumber}"/>
                    <TextBlock Text="готово" Style="{StaticResource ChipLabel}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SkipBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountSkipped" Text="0" Style="{StaticResource ChipNumber}"/>
                    <TextBlock Text="пропущено" Style="{StaticResource ChipLabel}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource ErrBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountFailed" Text="0" Style="{StaticResource ChipNumber}"/>
                    <TextBlock x:Name="CountFailedLabel" Text="ошибок" Style="{StaticResource ChipLabel}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <!-- list -->
          <ItemsControl x:Name="LogList" Grid.Row="1" Style="{StaticResource LogListStyle}"/>

          <!-- empty state -->
          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                      Visibility="{Binding Visibility, ElementName=LogEmpty}">
            <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="22"
                       Foreground="#FF454A51" HorizontalAlignment="Center"/>
            <TextBlock x:Name="LogEmpty" Text="Здесь появится журнал" FontSize="12.5" Foreground="{StaticResource Faint}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= Page: sync from server ================= -->
    <Grid x:Name="PageSync" Grid.Row="1" Margin="20,6,20,16" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- folders card -->
        <RowDefinition Height="Auto"/>  <!-- actions -->
        <RowDefinition Height="Auto"/>  <!-- progress -->
        <RowDefinition Height="*" MinHeight="96"/> <!-- log -->
        <RowDefinition Height="Auto"/>  <!-- DaVinci step -->
      </Grid.RowDefinitions>

      <!-- ===== Folders ===== -->
      <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
              CornerRadius="12">
        <StackPanel>
          <StackPanel Margin="16,14,16,14">
            <!-- source -->
            <TextBlock Style="{StaticResource FieldLabel}">
              <Run Text="Откуда"/><Run Text="  ·  папка на сервере" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
            </TextBlock>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SyncSource" Style="{StaticResource PathBox}" Tag="&#xE8CE;"/>
              <TextBlock Text="\\сервер\папка\проект">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=SyncSource}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Button x:Name="SyncSourceBrowse" Grid.Column="1" Style="{StaticResource GhostButton}" Height="36"
                      Padding="12,0,14,0" Margin="8,0,0,0" Tag="&#xE838;" Content="Обзор…" ToolTip="Выбрать папку на сервере"/>
            </Grid>

            <!-- destination -->
            <TextBlock Style="{StaticResource FieldLabel}" Margin="2,14,0,7">
              <Run Text="Куда"/><Run Text="  ·  папка на компьютере" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
            </TextBlock>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SyncDest" Style="{StaticResource PathBox}" Tag="&#xEDA2;"/>
              <TextBlock Text="D:\Proxy">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=SyncDest}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Button x:Name="SyncDestBrowse" Grid.Column="1" Style="{StaticResource GhostButton}" Height="36"
                      Padding="12,0,14,0" Margin="8,0,0,0" Tag="&#xE838;" Content="Обзор…" ToolTip="Выбрать локальную папку"/>
            </Grid>
          </StackPanel>

          <!-- summary -->
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,9,16,10"
                  Background="#FF15171A" CornerRadius="0,0,12,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="13"
                         Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
              <TextBlock x:Name="SyncSummary" Grid.Column="1" Text="Укажите папки — посчитаю прокси и место на диске"
                         FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- ===== Actions ===== -->
      <Grid Grid.Row="1" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="SyncRun" Content="Синхронизировать" MinWidth="196">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
              <Setter Property="Tag" Value="&#xE895;"/>
              <Style.Triggers>
                <Trigger Property="Content" Value="Остановить">
                  <Setter Property="Tag" Value="&#xE71A;"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <TextBlock x:Name="SyncStatus" Grid.Column="1" Text="" FontSize="12" Foreground="{StaticResource Muted}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"
                   TextTrimming="CharacterEllipsis" Margin="12,0,2,0"/>
      </Grid>

      <!-- ===== Progress ===== -->
      <ProgressBar x:Name="SyncProgress" Grid.Row="2" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100"
                   Value="0" Margin="0,14,0,0"/>

      <!-- ===== Log ===== -->
      <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource LogCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Style="{StaticResource LogHeader}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Журнал" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SyncCountDone" Text="0" Style="{StaticResource ChipNumber}"/>
                    <TextBlock Text="скопировано" Style="{StaticResource ChipLabel}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SkipBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SyncCountSkipped" Text="0" Style="{StaticResource ChipNumber}"/>
                    <TextBlock Text="уже есть" Style="{StaticResource ChipLabel}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource ErrBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SyncCountFailed" Text="0" Style="{StaticResource ChipNumber}"/>
                    <TextBlock x:Name="SyncCountFailedLabel" Text="ошибок" Style="{StaticResource ChipLabel}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl x:Name="SyncLog" Grid.Row="1" Style="{StaticResource LogListStyle}"/>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                      Visibility="{Binding Visibility, ElementName=SyncLogEmpty}">
            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="22"
                       Foreground="#FF454A51" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SyncLogEmpty" Text="Здесь появится журнал копирования" FontSize="12.5"
                       Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== DaVinci step ===== -->
      <Border Grid.Row="4" Margin="0,12,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="12" Padding="12,10,10,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="1,0,0,0"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
            <TextBlock Text="DaVinci Resolve" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="свяжет прокси с оригиналами" FontSize="12"
                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          </StackPanel>
          <Button x:Name="ResolveScriptButton" Grid.Column="2" Style="{StaticResource GhostButton}" Height="34"
                  Padding="12,0,14,0" VerticalAlignment="Center" Tag="&#xE896;" Content="Установить скрипт в DaVinci"/>
          <TextBlock x:Name="ResolveHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text=""
                     FontSize="12" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis"
                     Margin="12,8,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= Footer ================= -->
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FF0E0F11"
            Padding="16,8,14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="SponsorLink" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                ToolTip="t.me/adam_editing_page">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="12"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="Поддержать автора" VerticalAlignment="Center"/>
            <TextBlock Text="  ·  t.me/adam_editing_page" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Button>
        <Button x:Name="GithubLink" Grid.Column="1" Style="{StaticResource LinkButton}" Margin="8,0,4,0"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,1,6,0"/>
            <TextBlock Text="GitHub" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="VersionText" Grid.Column="2" Text="v1.0" FontSize="11.5" Foreground="{StaticResource Faint}"
                   VerticalAlignment="Center" Margin="6,0,2,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
